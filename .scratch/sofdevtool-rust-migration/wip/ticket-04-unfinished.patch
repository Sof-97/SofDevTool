+//! App-owned fresh Rust History storage. Payloads are opaque and never logged.
+use serde::{Deserialize, Serialize};
+use std::{
+    fs, io,
+    path::PathBuf,
+    sync::{Arc, Mutex},
+};
+pub const RETENTION: usize = 25;
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct HistoryEntry {
+    pub id: String,
+    pub captured_at: String,
+    pub utility_id: String,
+    pub snapshot_version: u32,
+    pub payload: serde_json::Value,
+}
+#[derive(Debug)]
+pub struct HistoryStore {
+    root: PathBuf,
+    gate: Arc<Mutex<()>>,
+}
+impl HistoryStore {
+    pub fn new(root: PathBuf) -> Self {
+        Self {
+            root,
+            gate: Arc::new(Mutex::new(())),
+        }
+    }
+    pub fn load(&self, id: &str) -> Result<Vec<HistoryEntry>, HistoryError> {
+        let p = self.path(id)?;
+        let b = match fs::read(&p) {
+            Ok(b) => b,
+            Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(vec![]),
+            Err(_) => return Err(HistoryError::Unavailable),
+        };
+        let f: File = serde_json::from_slice(&b).map_err(|_| HistoryError::Corrupt)?;
+        if f.utility_id != id || f.version != 1 {
+            return Err(HistoryError::Corrupt);
+        }
+        if f.entries.iter().any(|entry| entry.utility_id != id) {
+            return Err(HistoryError::Corrupt);
+        }
+        Ok(f.entries)
+    }
+    pub fn append(&self, e: HistoryEntry) -> Result<Vec<HistoryEntry>, HistoryError> {
+        let _guard = self.gate.lock().map_err(|_| HistoryError::Unavailable)?;
+        let utility_id = e.utility_id.clone();
+        let mut x = self.load(&e.utility_id)?;
+        x.push(e);
+        x.sort_by(|a, b| {
+            b.captured_at
+                .cmp(&a.captured_at)
+                .then_with(|| b.id.cmp(&a.id))
+        });
+        x.truncate(RETENTION);
+        self.write(&utility_id, &x)?;
+        Ok(x)
+    }
+    fn write(&self, id: &str, x: &[HistoryEntry]) -> Result<(), HistoryError> {
+        let p = self.path(id)?;
+        fs::create_dir_all(&self.root).map_err(|_| HistoryError::Unavailable)?;
+        let t = self.root.join(format!(".{id}.tmp"));
+        fs::write(
+            &t,
+            serde_json::to_vec(&File {
+                version: 1,
+                utility_id: id.into(),
+                entries: x.to_vec(),
+            })
+            .map_err(|_| HistoryError::Unavailable)?,
+        )
+        .map_err(|_| HistoryError::Unavailable)?;
+        fs::rename(t, p).map_err(|_| HistoryError::Unavailable)
+    }
+    fn path(&self, id: &str) -> Result<PathBuf, HistoryError> {
+        if id.is_empty()
+            || !id
+                .bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+        {
+            return Err(HistoryError::InvalidUtility);
+        }
+        Ok(self.root.join(format!("{id}.history.v1.json")))
+    }
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum HistoryError {
+    InvalidUtility,
+    Corrupt,
+    Unavailable,
+}
+#[derive(Serialize, Deserialize)]
+struct File {
+    version: u32,
+    utility_id: String,
+    entries: Vec<HistoryEntry>,
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn e(id: &str, n: u8) -> HistoryEntry {
+        HistoryEntry {
+            id: format!("{n:02}"),
+            captured_at: format!("2026-01-01T00:00:{n:02}Z"),
+            utility_id: id.into(),
+            snapshot_version: 99,
+            payload: serde_json::json!({"opaque":n}),
+        }
+    }
+    #[test]
+    fn corruption_isolated_and_preserved() {
+        let r = std::env::temp_dir().join(format!("h{}", std::process::id()));
+        fs::create_dir_all(&r).unwrap();
+        let p = r.join("json.history.v1.json");
+        fs::write(&p, b"bad").unwrap();
+        let s = HistoryStore::new(r.clone());
+        assert_eq!(s.append(e("json", 1)).unwrap_err(), HistoryError::Corrupt);
+        assert_eq!(fs::read(&p).unwrap(), b"bad");
+        assert_eq!(s.append(e("base64", 1)).unwrap().len(), 1);
+        fs::remove_dir_all(r).unwrap();
+    }
+    #[test]
+    fn unknown_snapshot_is_listed() {
+        let r = std::env::temp_dir().join(format!("h{}x", std::process::id()));
+        let s = HistoryStore::new(r.clone());
+        s.append(e("json", 1)).unwrap();
+        assert_eq!(s.load("json").unwrap()[0].snapshot_version, 99);
+        fs::remove_dir_all(r).unwrap();
+    }
+    #[test]
+    fn retention_uses_timestamp_then_stable_id() {
+        let r = std::env::temp_dir().join(format!("h{}r", std::process::id()));
+        let s = HistoryStore::new(r.clone());
+        for n in 0..30 {
+            let mut entry = e("json", n);
+            entry.captured_at = "2026-01-01T00:00:00Z".into();
+            s.append(entry).unwrap();
+        }
+        let entries = s.load("json").unwrap();
+        assert_eq!(entries.len(), RETENTION);
+        assert_eq!(entries[0].id, "29");
+        fs::remove_dir_all(r).unwrap();
+    }
+    #[test]
+    fn traversal_and_mismatched_entries_are_rejected() {
+        let r = std::env::temp_dir().join(format!("h{}v", std::process::id()));
+        let s = HistoryStore::new(r.clone());
+        assert_eq!(
+            s.load("../swift").unwrap_err(),
+            HistoryError::InvalidUtility
+        );
+        fs::create_dir_all(&r).unwrap();
+        fs::write(r.join("json.history.v1.json"), br#"{"version":1,"utility_id":"json","entries":[{"id":"x","captured_at":"x","utility_id":"base64","snapshot_version":1,"payload":null}]}"#).unwrap();
+        assert_eq!(s.append(e("json", 1)).unwrap_err(), HistoryError::Corrupt);
+        fs::remove_dir_all(r).unwrap();
+    }
+}
