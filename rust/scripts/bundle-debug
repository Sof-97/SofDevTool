#!/usr/bin/env bash
# Assemble a minimal, locally identified Debug bundle for the Rust application.
#
# It does not install, launch or notarize anything; it only produces
# `artifacts/SofDevToolRust.app` under the workspace so the binary has a real
# CFBundleIdentifier distinct from the Swift product.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bundle_id="com.gerardo.sofdevtool.rust"
app_dir="artifacts/SofDevToolRust.app"

exe="$(
    cargo build -p sofdevtool-app --bin sofdevtool --message-format=json |
        python3 -c '
import json, sys
for line in sys.stdin:
    try:
        message = json.loads(line)
    except ValueError:
        continue
    target = message.get("target", {})
    if (
        message.get("reason") == "compiler-artifact"
        and message.get("executable")
        and target.get("name") == "sofdevtool"
    ):
        print(message["executable"])
        break
'
)"

if [ -z "$exe" ] || [ ! -f "$exe" ]; then
    echo "could not resolve the built sofdevtool executable" >&2
    exit 1
fi

rm -rf "$app_dir"
mkdir -p "$app_dir/Contents/MacOS" "$app_dir/Contents/Resources"
cp "$exe" "$app_dir/Contents/MacOS/sofdevtool"

cat > "$app_dir/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>sofdevtool</string>
    <key>CFBundleIdentifier</key>
    <string>${bundle_id}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SofDevToolRust</string>
    <key>CFBundleDisplayName</key>
    <string>SofDevTool (Rust)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
PLIST

echo "built $app_dir"
echo "CFBundleIdentifier: $(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app_dir/Contents/Info.plist")"
