#!/bin/zsh
set -euo pipefail
cd "${0:A:h}/.."
run_base=1
run_release=0
run_ui=0
case "${1:-}" in
  "") ;;
  --release) run_release=1 ;;
  --ui) run_base=0; run_ui=1 ;;
  --full) run_release=1; run_ui=1 ;;
  *) echo "usage: scripts/verify [--release|--ui|--full]" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo "usage: scripts/verify [--release|--ui|--full]" >&2; exit 2; }
mkdir -p .artifacts/DerivedData .artifacts/TestResults
mkdir -p .artifacts/caches/home/Library/Caches .artifacts/caches/xdg .artifacts/caches/clang .artifacts/caches/swiftpm
export CFFIXED_USER_HOME="$PWD/.artifacts/caches/home"
export XDG_CACHE_HOME="$PWD/.artifacts/caches/xdg"
export CLANG_MODULE_CACHE_PATH="$PWD/.artifacts/caches/clang"
export SWIFTPM_MODULECACHE_OVERRIDE="$PWD/.artifacts/caches/swiftpm"
run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
unit_result=".artifacts/TestResults/Unit-${run_id}.xcresult"
ui_result=".artifacts/TestResults/UI-${run_id}.xcresult"
ui_derived=".artifacts/UIDerivedData-${run_id}"
common=(-project SofDevTool.xcodeproj -scheme SofDevTool -destination 'platform=macOS,arch=arm64' -derivedDataPath .artifacts/DerivedData -disableAutomaticPackageResolution CODE_SIGNING_ALLOWED=YES CODE_SIGN_IDENTITY=- MACOSX_DEPLOYMENT_TARGET=14.0 ARCHS=arm64)
set -x
if (( run_base )); then
  xcrun swift format lint --strict --configuration .swift-format --recursive SofDevTool SofDevToolTests SofDevToolUITests
  node scripts/verify-text-diff.mjs
  xcodebuild "${common[@]}" -configuration Debug build
  xcodebuild "${common[@]}" -configuration Debug test -skip-testing:SofDevToolUITests -resultBundlePath "$unit_result"
fi
if (( run_release )); then
  xcodebuild "${common[@]}" -configuration Release build
fi
if (( run_ui )); then
  xcodebuild -project SofDevTool.xcodeproj -scheme SofDevTool -destination 'platform=macOS,arch=arm64' -derivedDataPath "$ui_derived" -disableAutomaticPackageResolution CODE_SIGNING_ALLOWED=YES CODE_SIGN_IDENTITY=- MACOSX_DEPLOYMENT_TARGET=14.0 ARCHS=arm64 -configuration Debug test -only-testing:SofDevToolUITests -resultBundlePath "$ui_result"
fi
