#!/usr/bin/swift

import AppKit
import CoreText
import Foundation

let fileManager = FileManager.default
let scriptURL = URL(fileURLWithPath: CommandLine.arguments[0]).standardizedFileURL
let repository = scriptURL.deletingLastPathComponent().deletingLastPathComponent()
let sourceDirectory = repository.appending(path: "SofDevTool/Assets.xcassets/AppIcon.appiconset")
let destinationDirectory = repository.appending(path: "SofDevTool/Assets.xcassets/AppIcon-Debug.appiconset")

try fileManager.createDirectory(at: destinationDirectory, withIntermediateDirectories: true)

let manifestSource = sourceDirectory.appending(path: "Contents.json")
let manifestDestination = destinationDirectory.appending(path: "Contents.json")
if fileManager.fileExists(atPath: manifestDestination.path) {
    try fileManager.removeItem(at: manifestDestination)
}
try fileManager.copyItem(at: manifestSource, to: manifestDestination)

let iconNames = try fileManager.contentsOfDirectory(atPath: sourceDirectory.path)
    .filter { $0.hasSuffix(".png") }

for iconName in iconNames {
    let sourceURL = sourceDirectory.appending(path: iconName)
    let destinationURL = destinationDirectory.appending(path: iconName)
    let sourceData = try Data(contentsOf: sourceURL)
    guard let source = NSBitmapImageRep(data: sourceData), let sourceImage = source.cgImage else {
        throw CocoaError(.fileReadCorruptFile)
    }

    let width = sourceImage.width
    let height = sourceImage.height
    guard
        let colorSpace = CGColorSpace(name: CGColorSpace.sRGB),
        let context = CGContext(
            data: nil,
            width: width,
            height: height,
            bitsPerComponent: 8,
            bytesPerRow: 0,
            space: colorSpace,
            bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
        )
    else {
        throw CocoaError(.fileWriteUnknown)
    }

    let size = CGFloat(width)
    let bounds = CGRect(x: 0, y: 0, width: width, height: height)
    context.interpolationQuality = CGInterpolationQuality.high
    context.draw(sourceImage, in: bounds)

    context.saveGState()
    let iconClip = CGPath(
        roundedRect: bounds.insetBy(dx: size * 0.018, dy: size * 0.018),
        cornerWidth: size * 0.205,
        cornerHeight: size * 0.205,
        transform: nil
    )
    context.addPath(iconClip)
    context.clip()

    context.translateBy(x: size * 0.80, y: size * 0.80)
    context.rotate(by: -.pi / 4)

    let ribbonWidth = size * 0.62
    let ribbonHeight = max(CGFloat(3), size * 0.145)
    let ribbon = CGRect(
        x: -ribbonWidth / 2,
        y: -ribbonHeight / 2,
        width: ribbonWidth,
        height: ribbonHeight
    )
    let colors = [
        CGColor(red: 1.00, green: 0.55, blue: 0.17, alpha: 1),
        CGColor(red: 1.00, green: 0.77, blue: 0.31, alpha: 1),
    ] as CFArray
    let gradient = CGGradient(colorsSpace: colorSpace, colors: colors, locations: [0, 1])!
    context.saveGState()
    context.addRect(ribbon)
    context.clip()
    context.drawLinearGradient(
        gradient,
        start: CGPoint(x: 0, y: ribbon.minY),
        end: CGPoint(x: 0, y: ribbon.maxY),
        options: []
    )
    context.restoreGState()

    context.setStrokeColor(CGColor(red: 0.32, green: 0.16, blue: 0.04, alpha: 0.55))
    context.setLineWidth(max(1, size * 0.008))
    context.move(to: CGPoint(x: ribbon.minX, y: ribbon.minY))
    context.addLine(to: CGPoint(x: ribbon.maxX, y: ribbon.minY))
    context.move(to: CGPoint(x: ribbon.minX, y: ribbon.maxY))
    context.addLine(to: CGPoint(x: ribbon.maxX, y: ribbon.maxY))
    context.strokePath()

    if width >= 128 {
        let font = CTFontCreateWithName("SFProDisplay-Heavy" as CFString, ribbonHeight * 0.43, nil)
        let attributes: [NSAttributedString.Key: Any] = [
            NSAttributedString.Key(kCTFontAttributeName as String): font,
            NSAttributedString.Key(kCTForegroundColorAttributeName as String):
                CGColor(red: 0.07, green: 0.08, blue: 0.11, alpha: 1),
            .kern: ribbonHeight * 0.06,
        ]
        let text = NSAttributedString(string: "DEV", attributes: attributes)
        let line = CTLineCreateWithAttributedString(text)
        let textBounds = CTLineGetBoundsWithOptions(line, [.useGlyphPathBounds])
        context.textPosition = CGPoint(
            x: -textBounds.width / 2 - textBounds.minX,
            y: -textBounds.height / 2 - textBounds.minY
        )
        CTLineDraw(line, context)
    }

    context.restoreGState()

    guard let outputImage = context.makeImage() else {
        throw CocoaError(.fileWriteUnknown)
    }
    let output = NSBitmapImageRep(cgImage: outputImage)
    guard let data = output.representation(using: NSBitmapImageRep.FileType.png, properties: [:]) else {
        throw CocoaError(.fileWriteUnknown)
    }
    try data.write(to: destinationURL, options: Data.WritingOptions.atomic)
}

print("Generated \(iconNames.count) Debug app icon renditions in \(destinationDirectory.path)")
